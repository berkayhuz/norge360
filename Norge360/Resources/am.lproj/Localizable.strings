"guidelines.title" = "የማህበረሰብ መመሪያዎች";
"guidelines.intro" = "Norge360 ሕይወታቸው ወይም ጉዞአቸው ከኖርዌይ ጋር በሚያገናኙዋቸው ሰዎች መካከል ተግባራዊ፣ አክብሮት የተሞላበት ውይይት ነው።";
"guidelines.respect_title" = "የተከበሩ እና ጠቃሚ ይሁኑ";
"guidelines.respect_body" = "ሌሎች አባላትን አታስቸግሩ፣ አታስፈራሩ፣ አድልዎ አታድርጉ፣ አታጭበርብሩ፣ ወይም ሆን ብለው ሌሎች አባላትን አያሳስቱ። አለመግባባቶች በሰዎች ላይ ሳይሆን በሃሳብ ላይ ያተኩሩ።";
"guidelines.privacy_title" = "የግል መረጃን ጠብቅ";
"guidelines.privacy_body" = "የመታወቂያ ሰነዶችን፣ የኢሚግሬሽን ጉዳይ ዝርዝሮችን፣ የባንክ መረጃን፣ የቤት አድራሻዎችን፣ የግል አድራሻዎችን፣ ወይም የሌላ ሰውን መረጃ ያለፈቃድ አትለጥፉ።";
"guidelines.guidance_title" = "ይፋዊ ውሳኔዎችን ሳይሆን ልምድን ያካፍሉ።";
"guidelines.guidance_body" = "የማህበረሰብ ልጥፎች የግል ልምድ እንጂ ኦፊሴላዊ የኢሚግሬሽን፣ የግብር፣ የህግ፣ የጤና ወይም የደህንነት ምክር አይደሉም። እርስዎን ለሚመለከቱ ውሳኔዎች የሚመለከተውን የኖርዌይ ባለስልጣን ያረጋግጡ።";
"guidelines.reports_title" = "ሪፖርቶች እንዴት እንደሚሠሩ";
"guidelines.reports_body" = "ሪፖርቶች ግላዊ እና የሚታዩት ለNorge360's አወያይነት ሂደት ብቻ ነው። በጣም ቅርብ የሆነውን ምክንያት ይምረጡ እና ምንም ተጨማሪ ሚስጥራዊነት ያለው መረጃ አያካትቱ። ሪፖርት ማድረግ የአደጋ ጊዜ አገልግሎት አይደለም; አንድ ሰው በአፋጣኝ አደጋ ላይ ከሆነ የአካባቢ ድንገተኛ አገልግሎቶችን ያነጋግሩ።";
