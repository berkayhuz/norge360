"legal.privacy_intro" = "ይህ ፖሊሲ Norge360 ሊያሄድ የሚችለውን የመረጃ አይነቶች እና እሱን ለመጠበቅ ጥቅም ላይ የሚውሉትን የግላዊነት መርሆዎች ያብራራል።";
"legal.informational_title" = "የመረጃ አገልግሎት";
"legal.informational_body" = "Norge360 የእቅድ እና የመረጃ መሳሪያ ነው። የመንግስት ኤጀንሲ፣ የኢሚግሬሽን ጠበቃ፣ የግብር አማካሪ ወይም ይፋዊ የማመልከቻ ፖርታል አይደለም።";
"legal.account_title" = "መለያህ";
"legal.account_body" = "የእርስዎን የመግባት ዝርዝሮች ደህንነቱ የተጠበቀ እንዲሆን እና ግላዊ ባህሪያትን ሲጠቀሙ ትክክለኛ መረጃ የመስጠት ኃላፊነት አለብዎት።";
"legal.sources_title" = "ኦፊሴላዊ ምንጮች";
"legal.sources_body" = "የሂደቱ መረጃ ሊለወጥ ይችላል. ከመተግበሪያው የተገናኘውን ኦፊሴላዊ ባለስልጣን ሁልጊዜ አስፈላጊ መስፈርቶችን ያረጋግጡ።";
"legal.acceptable_use_title" = "ተቀባይነት ያለው አጠቃቀም";
"legal.acceptable_use_body" = "አገልግሎቱን አላግባብ አይጠቀሙ፣ በአሰራሩ ላይ ጣልቃ አይግቡ፣ ያልተፈቀደ መዳረሻ አይሞክሩ ወይም የሚመለከተውን ህግ በሚጥስ መንገድ አይጠቀሙበት።";
"legal.changes_title" = "በአገልግሎቱ ላይ ለውጦች";
"legal.changes_body" = "Norge360 እየዳበረ ሲመጣ ባህሪያት እና እነዚህ ውሎች ሊዘመኑ ይችላሉ። የቁሳቁስ ለውጦች በመተግበሪያው በኩል ማሳወቅ አለባቸው.";
"legal.data_title" = "የምንሰበስበው መረጃ";
"legal.data_body" = "የተጠየቁ ባህሪያትን ለማቅረብ በሚያስፈልግበት ጊዜ አገልግሎቱ የኢሜል አድራሻዎን፣ የቋንቋ ምርጫዎን፣ የመዛወሪያ መልሶችን፣ የማረጋገጫ ዝርዝር ሂደት እና የሂሳብ ማሽን ሁኔታዎችን ሊያስተናግድ ይችላል።";
"legal.use_title" = "መረጃ እንዴት ጥቅም ላይ እንደሚውል";
"legal.use_body" = "መረጃ መለያዎን ለማቅረብ፣ የመዛወሪያ ዕቅድዎን ለማመንጨት፣ እድገትን ለመቆጠብ፣ አገልግሎቱን ለማስጠበቅ እና የዋና ምርት አስተማማኝነትን ለማሻሻል ይጠቅማል።";
"legal.sensitive_title" = "ሚስጥራዊነት ያለው መረጃ";
"legal.sensitive_body" = "የፓስፖርት ቁጥሮችን፣ የብሔራዊ መታወቂያ ቁጥሮችን፣ የባንክ መታወቂያ ማስረጃዎችን፣ የባንክ መታወቂያዎችን፣ የጤና መዝገቦችን ወይም የኢሚግሬሽን ጉዳይ መለያዎችን አታቅርቡ።";
"legal.security_title" = "ማከማቻ እና ደህንነት";
"legal.security_body" = "Norge360 የተሰበሰበ ውሂብን ለመቀነስ እና የመለያ መረጃን በመዳረሻ መቆጣጠሪያዎች እና ደህንነቱ በተጠበቀ የአገልግሎት ውቅር ለመጠበቅ የተነደፈ ነው።";
"legal.rights_title" = "የእርስዎ ምርጫዎች";
"legal.rights_body" = "በሚመለከተው መስፈርት መሰረት ከመለያዎ ጋር የተጎዳኘውን የመገለጫ መረጃ መገምገም፣ ማረም ወይም መሰረዝ መቻል አለቦት።";
"legal.review_notice" = "ረቂቅ የምርት ቅጂ - ህጋዊ ግምገማ ያግኙ እና የምርት መለቀቅ በፊት የኩባንያ/የእውቂያ ዝርዝሮችን ያክሉ።";
"introduction.details_title" = "ይበልጥ ግልጽ የሆነ እንቅስቃሴ፣ አንድ እርምጃ በአንድ ጊዜ";
"introduction.details_body" = "ለበለጠ መረጃ ይህን ፓነል ወደ ላይ ያንሱት። Norge360 የእርስዎን ቀጣይ እርምጃዎች፣ ይፋዊ ምንጮች እና የዕለት ተዕለት እቅድ ወደ አንድ የተረጋጋ ቦታ ያመጣል።";
