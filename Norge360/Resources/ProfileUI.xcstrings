    "profile.ui.load_error_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check your connection and try again."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantınızı kontrol edip tekrar deneyin."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sjekk forbindelsen og prøv igjen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال خود را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez votre connexion et réessayez."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba tu conexión y vuelve a intentarlo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überprüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте підключення та повторіть спробу."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте подключение и повторите попытку."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubi xidhiidhkaaga oo isku day mar kale."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ርክብካ መርምር እሞ እንደገና ፈትን።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ግንኙነትዎን ይፈትሹ እና እንደገና ይሞክሩ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا کنکشن چیک کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال خود را چک کنید و دوباره امتحان کنید."
          }
        }
      }
    },
