    "profile.ui.avatar_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold to enlarge the photo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı büyütmek için basılı tutun."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk og hold for å forstørre bildet."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المس مع الاستمرار لتكبير الصورة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لمس کنید و نگه دارید تا عکس بزرگ شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez et maintenez pour agrandir la photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque y mantenga presionado para ampliar la foto."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Berühren und halten Sie, um das Foto zu vergrößern."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисніть і утримуйте, щоб збільшити фотографію."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите и удерживайте, чтобы увеличить фотографию."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij i przytrzymaj, aby powiększyć zdjęcie."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Taabo oo hayso si aad sawirka u weynayso."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ነቲ ስእሊ ንምዕባይ ተንኪፍካ ምሓዝ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፎቶውን ለማስፋት ይንኩ እና ይያዙ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تصویر کو بڑا کرنے کے لیے ٹچ کریں اور دبائے رکھیں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "برای بزرگ کردن عکس لمس و نگه دارید."
          }
        }
      }
