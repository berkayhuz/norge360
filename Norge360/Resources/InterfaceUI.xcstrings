{
  "sourceLanguage": "en",
  "strings": {
    "image.adjust_hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to frame your photo. Adjust it before sharing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotoğrafı sürükleyerek konumlandır. Paylaşmadan önce düzenle."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra for å ramme inn bildet. Juster det før du deler."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتأطير صورتك. اضبطه قبل المشاركة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بکشید تا عکس خود را قاب کنید. قبل از اشتراک گذاری آن را تنظیم کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour encadrer votre photo. Ajustez-le avant de partager."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para enmarcar tu foto. Ajústalo antes de compartir."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie, um Ihr Foto einzurahmen. Passen Sie es vor dem Teilen an."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть, щоб обрамити фотографію. Налаштуйте його, перш ніж ділитися."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите, чтобы создать рамку для фотографии. Настройте его, прежде чем делиться."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby wykadrować zdjęcie. Dostosuj go przed udostępnieniem."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiid si aad u sawirto sawirkaaga. hagaaji ka hor inta aadan wadaagin."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ስእልኻ ፍሬም ንምግባር ስሓብ። ቅድሚ ምክፋልኩም ኣስተኻኽልዎ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ፎቶህን ለመቅረጽ ጎትት። ከማጋራትዎ በፊት ያስተካክሉት።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی تصویر کو فریم کرنے کے لیے گھسیٹیں۔ شیئر کرنے سے پہلے اسے ایڈجسٹ کریں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "برای قاب کردن عکس تان بکشید. قبل از اشتراک گذاری آنرا تنظیم کنید."
          }
        }
      }
    },
