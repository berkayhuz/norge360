    "hub.welcome_body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local conversations, shared interests and a little help along the way."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel sohbetler, ortak ilgi alanları ve her adımda biraz destek."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale samtaler, felles interesser og litt hjelp underveis."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحادثات المحلية والاهتمامات المشتركة والقليل من المساعدة على طول الطريق."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گفتگوهای محلی، علایق مشترک و کمی کمک در طول مسیر."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des conversations locales, des intérêts partagés et un peu d’aide en cours de route."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversaciones locales, intereses compartidos y un poco de ayuda en el camino."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Gespräche, gemeinsame Interessen und ein wenig Hilfe unterwegs."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Місцеві розмови, спільні інтереси та невелика допомога на цьому шляху."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Местные разговоры, общие интересы и небольшая помощь в пути."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalne rozmowy, wspólne zainteresowania i mała pomoc po drodze."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Sheeko maxalli ah, danaha la wadaago iyo in yar oo caawimo ah inta lagu jiro jidka."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ናይ ከባቢ ዕላላት፡ ናይ ሓባር ድሌታትን ንእሽቶ ሓገዝን ኣብ መንገዲ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "የአካባቢ ውይይቶች፣ የጋራ ፍላጎቶች እና በመንገድ ላይ ትንሽ እገዛ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مقامی گفتگو، مشترکہ دلچسپیاں اور راستے میں تھوڑی مدد۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "مکالمات محلی، علایق مشترک و یک کمک کوچک در طول راه."
          }
        }
      }
    },
