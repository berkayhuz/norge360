    "hub.groups_explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your groups and city, followed by more communities to explore."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce grupların ve şehrin, ardından keşfedebileceğin topluluklar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine grupper og byer, etterfulgt av flere fellesskap å utforske."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجموعاتك ومدينتك، تليها المزيد من المجتمعات لاستكشافها."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گروه ها و شهر شما و پس از آن جوامع بیشتری برای کاوش."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos groupes et votre ville, suivis d'autres communautés à explorer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus grupos y ciudad, seguidos de más comunidades para explorar."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Gruppen und Ihre Stadt, gefolgt von weiteren Gemeinden, die es zu erkunden gilt."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші групи та місто, а потім інші спільноти для вивчення."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши группы и город, а также другие сообщества для изучения."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje grupy i miasto, a następnie więcej społeczności do odkrycia."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Kooxahaaga iyo magaaladaada, waxaa ku xiga jaaliyado badan si aad u sahamiso."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ጉጅለታትኩምን ከተማኹምን፡ ስዒቡ ድማ ተወሳኺ ማሕበረሰባት ክትድህስሱ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ቡድኖችዎ እና ከተማዎ፣ ተጨማሪ ማህበረሰቦችን ይከተሉ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے گروپس اور شہر، اس کے بعد مزید کمیونٹیز دریافت کریں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "گروه ها و شهر شما، به تعقیب آن جوامع بیشتر برای اکتشاف."
          }
        }
      }
    },
