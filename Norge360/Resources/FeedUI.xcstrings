    "post_detail.open": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open this post"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderiyi aç"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne dette innlegget"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح هذه المشاركة"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این پست را باز کنید"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre ce message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre esta publicación"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie diesen Beitrag"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте цю публікацію"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть этот пост"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz ten post"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fur qoraalkan"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ነዚ ጽሑፍ ክፈትዎ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህን ልጥፍ ይክፈቱ"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس پوسٹ کو کھولیں۔"
          }
        },
