"legal.terms_title" = "Shuruudaha Isticmaalka";
"legal.privacy_title" = "Siyaasadda Qarsoonnimada";
"legal.terms_intro" = "Erayadani waxay sharxayaan xeerarka aasaasiga ah ee isticmaalka arjiga Norge360 iyo sifada qorshaynta raritaankeeda.";
"legal.privacy_intro" = "Nidaamkani wuxuu sharxayaa noocyada macluumaadka Norge360 laga yaabo inuu socodsiiyo iyo mabaadi'da gaar ahaaneed ee loo isticmaalo si loo ilaaliyo.";
"legal.informational_title" = "Adeegga macluumaadka";
"legal.informational_body" = "Norge360 waa qorshe iyo qalab macluumaad. Ma aha wakaalad dawladeed, qareen laanta socdaalka, la taliyaha cashuuraha, ama bogga rasmiga ah ee codsiga.";
"legal.account_title" = "Koontadaada";
"legal.account_body" = "Adiga ayaa mas'uul ka ah inaad si ammaan ah u ilaaliso faahfaahinta gelistaada iyo bixinta macluumaad sax ah markaad isticmaaleyso sifooyin gaar ah.";
"legal.sources_title" = "Ilaha rasmiga ah";
"legal.sources_body" = "Macluumaadka habraaca ayaa isbedeli kara. Had iyo jeer ka xaqiiji shuruudaha muhiimka ah maamulka rasmiga ah ee ku xiran codsiga.";
"legal.acceptable_use_title" = "Isticmaalka la aqbali karo";
"legal.acceptable_use_body" = "Ha si xun u isticmaalin adeega, ha faragalin hawl galkeeda, ha isku dayin gelid aan la ogolayn, ama ha u isticmaalin si ka hor imanaysa sharciga lagu dabaqi karo.";
"legal.changes_title" = "Isbeddellada adeegga";
"legal.changes_body" = "Tilmaamaha iyo shuruudahan waa la cusboonaysiin karaa marka Norge360 horumariyo. Isbeddellada agabka waa in lagu ogeysiiyaa codsiga.";
"legal.data_title" = "Xogta aan ururino";
"legal.data_body" = "Adeeggu waxa laga yaabaa inuu habeeyo ciwaanka iimaylka, dookha luqadda, jawaabaha raritaan, horumarka liiska hubinta, iyo xaaladaha xisaabiyaha marka loo baahdo si loo bixiyo sifada la codsado.";
"legal.use_title" = "Sida macluumaadka loo isticmaalo";
"legal.use_body" = "Macluumaadka waxa loo isticmaalaa in lagu bixiyo koontadaada, curinta qorshahaaga raritaan, kaydinta horumarka, sugidda adeega, iyo horumarinta isku halaynta alaabta asaasiga ah.";
"legal.sensitive_title" = "Xog xasaasi ah";
"legal.sensitive_body" = "Ha soo gudbin lambarada baasaboorka, nambarada aqoonsiga qaranka, aqoonsiga BankID, aqoonsiga bangiga, diiwaanada caafimaadka, ama aqoonsiga kiiska socdaalka.";
"legal.security_title" = "Kaydinta iyo amniga";
"legal.security_body" = "Norge360 waxaa loogu talagalay in lagu yareeyo xogta la ururiyey oo lagu ilaaliyo macluumaadka akoontada iyada oo loo marayo kontaroolada gelitaanka iyo qaabeynta adeegga ammaansan.";
"legal.rights_title" = "Doorashadaada";
"legal.rights_body" = "Waa inaad dib u eegis ku samayn kartaa, saxi kartaa, ama tirtiri kartaa macluumaadka boggaaga ee la xidhiidha koontadaada, iyada oo ku xidhan shuruudaha lagu dabaqi karo.";
"legal.review_notice" = "Nuqul alaabada qabyada ah - hel dib u eegis sharci oo ku dar faahfaahinta shirkadda/xidhiidhka ka hor inta aan la sii dayn wax soo saarka.";
"introduction.details_title" = "Dhaqdhaqaaq cad, hal tallaabo markiiba";
"introduction.details_body" = "U soo jiid guddigan wixii macluumaad dheeraad ah Norge360 waxay keenaysaa tillaabooyinkaaga xiga, ilaha rasmiga ah, iyo qorshaynta maalinlaha ah hal meel deggan.";
"welcome.title" = "Hab deggen oo aad ku qorsheyn karto u soo guuristaada Norway.";
"welcome.message" = "Norge360 waxay kaa caawinaysaa inaad fahanto waxaad u baahan tahay inaad samayso markaad u soo guurayso Norway.";
