"guidelines.title" = "Tilmaamaha bulshada";
"guidelines.intro" = "Norge360 waxaa loogu talagalay wada sheekeysi wax ku ool ah, ixtiraam leh oo dhexmara dadka noloshooda ama safarradoodu ku xiran yihiin Norway.";
"guidelines.respect_title" = "Noqo qof ixtiraam leh oo waxtar leh";
"guidelines.respect_body" = "Ha dhibin, ha hanjabin, ha takoorin, ha khiyaameyn, ama si ula kac ah ha u marin habaabin xubnaha kale. Khilaafaadka ku hay fikradaha, maaha dadka.";
"guidelines.privacy_title" = "Ilaali macluumaadka gaarka ah";
"guidelines.privacy_body" = "Ha dhajin dukumeenti aqoonsi, faahfaahinta kiiska socdaalka, macluumaadka bangiga, ciwaanada guriga, faahfaahinta xiriirka gaarka ah, ama macluumaadka qof kale fasax la'aan.";
"guidelines.guidance_title" = "Wadaag khibrad, ma aha go'aanno rasmi ah";
"guidelines.guidance_body" = "Qoraalada bulshadu waa khibrad shakhsi, maaha socdaalka rasmiga ah, cashuurta, sharciga, caafimaadka, ama talada badbaadada. Ka hubi hay'adda ay khusayso ee Norway go'aamada adiga khuseeya.";
"guidelines.reports_title" = "Sida warbixinadu u shaqeeyaan";
"guidelines.reports_body" = "Warbixinadu waa kuwo gaar ah oo la arki karo kaliya habka dhexdhexaadinta ee Norge360. Dooro sababta ugu dhow oo ha ku darin macluumaad xasaasi ah oo dheeri ah. Warbixintu maaha adeeg degdeg ah; la xidhiidh adeegyada degdega ah ee deegaanka haddii qof uu khatar degdeg ah ku jiro.";
"guidelines.notice" = "Xeerarkani waxay khuseeyaan qoraalada, faallooyinka, kooxaha, iyo dhacdooyinka. Jebinta culus ama soo noqnoqda waxay horseedi kartaa ka saarida nuxurka, ka qaybgalka xaddidan, ama ficilka koontada ee hoos yimaada habka dhexdhexaadinta.";
