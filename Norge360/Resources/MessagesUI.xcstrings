    "chat.delete_conversation_confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the conversation from your inbox only. It does not delete messages for the other member or from an open safety review."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem sohbeti yalnızca gelen kutunuzdan kaldırır. Diğer üyenin mesajlarını veya açık güvenlik incelemesindeki içerikleri silmez."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette fjerner kun samtalen fra innboksen din. Den sletter ikke meldinger for det andre medlemmet eller fra en åpen sikkerhetsgjennomgang."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة المحادثة من البريد الوارد الخاص بك فقط. ولا يحذف الرسائل الخاصة بالعضو الآخر أو من مراجعة السلامة المفتوحة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "با این کار مکالمه فقط از صندوق ورودی شما حذف می شود. پیام‌های عضو دیگر یا از بررسی ایمنی باز را حذف نمی‌کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime uniquement la conversation de votre boîte de réception. Il ne supprime pas les messages destinés à l'autre membre ni ceux d'un examen de sécurité ouvert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina la conversación únicamente de tu bandeja de entrada. No elimina mensajes del otro miembro ni de una revisión de seguridad abierta."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird die Konversation nur aus Ihrem Posteingang entfernt. Nachrichten für das andere Mitglied oder aus einer offenen Sicherheitsüberprüfung werden nicht gelöscht."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить розмову лише з папки \"Вхідні\". Це не видаляє повідомлення для іншого учасника або з відкритої перевірки безпеки."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит разговор только из вашего почтового ящика. Он не удаляет сообщения другого участника или из открытой проверки безопасности."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie rozmowy wyłącznie z Twojej skrzynki odbiorczej. Nie usuwa wiadomości od innego członka ani z otwartego przeglądu bezpieczeństwa."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Tani waxay wada hadalka ka saaraysaa sanduuqaaga fariimaha kaliya. Ma tirtirto fariimaha xubinta kale ama dib u eegista badbaadada furan."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "እዚ ድማ ነቲ ዕላል ካብ ኢንቦክስካ ጥራይ የወግዶ። ንኻልእ ኣባል ወይ ካብ ክፉት ናይ ድሕነት ዳግመ ግምት መልእኽትታት ኣይድምስስን እዩ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ውይይቱን ከገቢ መልእክት ሳጥንህ ብቻ ያስወግዳል። ለሌላ አባል ወይም ከክፍት የደህንነት ግምገማ መልዕክቶችን አይሰርዝም።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ بات چیت کو صرف آپ کے ان باکس سے ہٹا دیتا ہے۔ یہ دوسرے ممبر کے لیے یا کھلے حفاظتی جائزے سے پیغامات کو حذف نہیں کرتا ہے۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "این فقط مکالمه را از صندوق ورودی شما حذف میکند. این پیام ها را برای عضو دیگر یا از یک بررسی ایمنی باز حذف نمیکند."
          }
        }
      }
    },
