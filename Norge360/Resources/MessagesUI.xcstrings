    "chat.restricted_composer": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This conversation is restricted. Turn off Restrict in conversation settings to reply."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbet kısıtlandı. Yanıtlamak için sohbet ayarlarından kısıtlamayı kaldırın."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne samtalen er begrenset. Slå av Begrens i samtaleinnstillingene for å svare."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المحادثة مقيدة. قم بإيقاف تشغيل التقييد في إعدادات المحادثة للرد."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این گفتگو محدود است. برای پاسخ دادن، Restrict را در تنظیمات مکالمه خاموش کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette conversation est restreinte. Désactivez Restreindre dans les paramètres de conversation pour répondre."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conversación está restringida. Desactive Restringir en la configuración de conversación para responder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gespräch ist eingeschränkt. Deaktivieren Sie in den Konversationseinstellungen die Option „Antworten beschränken“."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця бесіда обмежена. Щоб відповісти, вимкніть параметр «Обмежити» в налаштуваннях розмови."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот разговор ограничен. Отключите параметр «Ограничить» в настройках беседы для ответа."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta rozmowa jest ograniczona. Wyłącz opcję Ogranicz w ustawieniach rozmowy, aby odpowiedzieć."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wadahadalkan waa la xaddiday. Demi Xaddidaad dejinta wadahadalka si aad uga jawaabto."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "እዚ ዕላል እዚ ድሩት እዩ። መልሲ ንምሃብ ኣብ ቅጥዕታት ዕላል Restrict ኣጥፍእዎ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህ ውይይት የተገደበ ነው። ምላሽ ለመስጠት በውይይት ቅንጅቶች ውስጥ ገደብ ያጥፉ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ گفتگو محدود ہے۔ جواب دینے کے لیے گفتگو کی ترتیبات میں پابندی کو آف کریں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "این گفتگو محدود شده است. برای پاسخ دادن، محدودیت را در تنظیمات مکالمه خاموش کنید."
          }
        }
      }
    },
    "chat.restriction_note": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mute stops push notifications for this conversation. Restrict also moves it to Restricted and hides read receipts. You can still read incoming messages and remove the restriction here at any time."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessize alma bu sohbetin anlık bildirimlerini kapatır. Kısıtlama ayrıca sohbeti Kısıtlananlar bölümüne taşır ve okundu bilgisini gizler. Gelen mesajları okuyabilir ve kısıtlamayı buradan istediğiniz zaman kaldırabilirsiniz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Demp stopper pushvarslinger for denne samtalen. Begrens flytter den også til Begrenset og skjuler lesekvitteringer. Du kan fortsatt lese innkommende meldinger og fjerne begrensningen her når som helst."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي كتم الصوت إلى إيقاف دفع الإشعارات لهذه المحادثة. يؤدي \"تقييد\" أيضًا إلى نقله إلى \"مقيد\" ويخفي إيصالات القراءة. لا يزال بإمكانك قراءة الرسائل الواردة وإزالة القيود هنا في أي وقت."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نادیده گرفتن اعلان‌های فشاری این مکالمه را متوقف می‌کند. Restrict همچنین آن را به Restricted منتقل می کند و رسیدهای خوانده شده را پنهان می کند. همچنان می‌توانید پیام‌های دریافتی را بخوانید و محدودیت را در اینجا در هر زمانی حذف کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La fonction Muet arrête les notifications push pour cette conversation. Restreindre le déplace également vers Restreint et masque les confirmations de lecture. Vous pouvez toujours lire les messages entrants et supprimer la restriction ici à tout moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenciar detiene las notificaciones automáticas de esta conversación. Restringir también lo mueve a Restringido y oculta los recibos de lectura. Aún puedes leer los mensajes entrantes y eliminar la restricción aquí en cualquier momento."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch die Stummschaltung werden Push-Benachrichtigungen für diese Konversation gestoppt. „Einschränken“ verschiebt es auch in „Eingeschränkt“ und blendet Lesebestätigungen aus. Sie können eingehende Nachrichten weiterhin lesen und die Einschränkung hier jederzeit aufheben."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнення звуку зупиняє push-сповіщення для цієї розмови. Обмежити також переміщує його в обмежений і приховує сповіщення про прочитання. Ви все ще можете читати вхідні повідомлення та зняти обмеження тут у будь-який час."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить звук останавливает push-уведомления для этого разговора. Ограничение также переводит его в режим «Ограничено» и скрывает уведомления о прочтении. Вы по-прежнему можете прочитать входящие сообщения и снять ограничение здесь в любое время."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyciszenie zatrzymuje powiadomienia push dla tej rozmowy. Ogranicz powoduje również przeniesienie go do opcji Ograniczone i ukrywa potwierdzenia odczytu. W każdej chwili możesz nadal czytać przychodzące wiadomości i usuwać ograniczenia."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrabka aamusi wuxuu joojiyaa ogaysiisyada riixitaanka ee wadahadalkan. Xannidu waxay sidoo kale u rari doontaa xaddidan waxayna qarisaa rasiidhada akhrinta. Waxaad weli akhrin kartaa fariimaha soo socda oo aad ka saari kartaa xaddidaadda halkan wakhti kasta."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ድምጺ ኣልቦ ነዚ ዕላል ዝኸውን ናይ ምድፋእ መተሓሳሰቢታት ደው የብሎ። Restrict ናብ Restricted እውን የግዕዞን ዝተነበበ ቅብሊታት ይሓብእን። ሕጂ ውን ዝኣትዉ መልእኽትታት ከተንብቡን ነቲ ገደብ ኣብዚ ኣብ ዝኾነ እዋን ከተውጽእዎን ትኽእሉ ኢኹም።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ድምጸ-ከል ለዚህ ውይይት የግፋ ማሳወቂያዎችን ያቆማል። መገደብ ወደ የተገደበ ያንቀሳቅሰዋል እና የተነበበ ደረሰኞችን ይደብቃል። አሁንም ገቢ መልዕክቶችን ማንበብ እና እዚህ በማንኛውም ጊዜ እገዳውን ማስወገድ ይችላሉ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش اس گفتگو کے لیے پش اطلاعات کو روکتا ہے۔ Restrict بھی اسے Restricted میں لے جاتا ہے اور پڑھنے کی رسیدیں چھپاتا ہے۔ آپ اب بھی آنے والے پیغامات پڑھ سکتے ہیں اور کسی بھی وقت یہاں سے پابندی ہٹا سکتے ہیں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "خاموش کردن اعلان های فشاری را برای این مکالمه متوقف میسازد. محدود کردن همچنان آنرا به محدود شده انتقال میدهد و رسید های خوانده شده را پنهان میکند. شما هنوز هم میتوانید پیام های ورودی را بخوانید و در هر زمان محدودیت را اینجا حذف کنید."
          }
        }
      }
    },
    "chat.retention_note": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages do not expire automatically. Delete for me hides a message from your view; it does not remove the other member’s copy or records needed to review a safety report."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mesajlar otomatik olarak silinmez. Benim için sil, mesajı sizin görünümünüzden gizler; diğer üyenin kopyasını veya şikayet incelemesi için gerekli kayıtları silmez."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Meldinger utløper ikke automatisk. Slett for meg skjuler en melding fra visningen din; det fjerner ikke det andre medlemmets kopi eller registreringer som er nødvendige for å se gjennom en sikkerhetsrapport."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تنتهي صلاحية الرسائل تلقائيًا. الحذف بالنسبة لي يخفي رسالة من وجهة نظرك؛ ولا يؤدي ذلك إلى إزالة نسخة العضو الآخر أو السجلات اللازمة لمراجعة تقرير السلامة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیام ها به طور خودکار منقضی نمی شوند. حذف برای من پیامی را از دید شما پنهان می کند. کپی یا سوابق دیگر اعضا را که برای بررسی گزارش ایمنی لازم است حذف نمی کند."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les messages n'expirent pas automatiquement. Supprimer pour moi masque un message de votre vue ; il ne supprime pas la copie ou les dossiers de l’autre membre nécessaires à l’examen d’un rapport de sécurité."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los mensajes no caducan automáticamente. Eliminar para mí oculta un mensaje de tu vista; no elimina la copia ni los registros del otro miembro necesarios para revisar un informe de seguridad."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachrichten verfallen nicht automatisch. Durch „Für mich löschen“ wird eine Nachricht aus Ihrer Ansicht ausgeblendet. Es werden keine Kopien oder Aufzeichnungen des anderen Mitglieds entfernt, die zur Überprüfung eines Sicherheitsberichts erforderlich sind."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін дії повідомлень не закінчується автоматично. Видалити для мене приховує повідомлення від вашого перегляду; він не видаляє копію або записи іншого учасника, необхідні для перегляду звіту про безпеку."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок действия сообщений не истекает автоматически. Удалить для меня скрывает сообщение от вашего просмотра; он не удаляет копию или записи другого участника, необходимые для просмотра отчета о безопасности."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomości nie wygasają automatycznie. Usuń dla mnie ukrywa wiadomość przed Twoim widokiem; nie usuwa kopii ani zapisów drugiego członka potrzebnych do przeglądu raportu o bezpieczeństwie."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Fariimaha si toos ah uma dhacayaan I tir tir waxay kaa qarinaysaa fariin aragtidaada; kama saarayso nuqulka xubinta kale ama diiwaanka loo baahan yahay si loo eego warbixinta badbaadada."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "መልእኽትታት ብኣውቶማቲክ ግዜኦም ኣይሓልፉን እዮም። Delete for me ካብ ርእይቶኻ መልእኽቲ ይሓብእ፤ ንጸብጻብ ድሕነት ንምግምጋም ዘድሊ ቅዳሕ ወይ መዛግብቲ ናይቲ ካልእ ኣባል ኣየወግድን እዩ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "መልዕክቶች በራስ-ሰር ጊዜያቸው አያበቃም። ለእኔ ሰርዝ ከእይታህ መልእክት ይደብቃል; የደህንነት ሪፖርትን ለመገምገም የሌላውን አባል ቅጂ ወይም መዛግብት አያስወግድም።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیغامات خود بخود ختم نہیں ہوتے ہیں۔ میرے لیے حذف کرنا آپ کے خیال سے ایک پیغام چھپاتا ہے۔ یہ دوسرے ممبر کی کاپی یا ریکارڈز کو نہیں ہٹاتا ہے جو حفاظتی رپورٹ کا جائزہ لینے کے لیے درکار ہے۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "پیام ها بطور خودکار منقضی نمیشوند. حذف برای من یک پیام را از دید شما پنهان میکند؛ این کاپی یا سوابق عضو دیگر را که برای مرور یک گزارش ایمنی نیاز است حذف نمیکند."
          }
        }
      }
    },
