    "chat.appearance_note": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These appearance choices apply only to your view of this conversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu görünüm tercihleri yalnızca sizin sohbet ekranınıza uygulanır."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Disse utseendevalgene gjelder bare for synet ditt på denne samtalen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنطبق اختيارات المظهر هذه فقط على طريقة عرضك لهذه المحادثة."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این انتخاب های ظاهری فقط برای دیدگاه شما از این مکالمه اعمال می شود."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces choix d'apparence s'appliquent uniquement à votre vision de cette conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas opciones de apariencia se aplican sólo a su vista de esta conversación."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Darstellungsoptionen gelten nur für Ihre Sicht auf dieses Gespräch."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці варіанти зовнішнього вигляду стосуються лише вашого бачення цієї розмови."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти варианты внешнего вида применяются только к вашему взгляду на этот разговор."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te opcje wyglądu dotyczą tylko Twojego widoku tej rozmowy."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorashooyinkan muuqaalka ah waxay khuseeyaan oo keliya aragtidaada wada hadalka."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "እዞም ናይ መልክዕ ምርጫታት እዚኣቶም ነቲ ብዛዕባ እዚ ዝርርብ ዘለካ ኣረኣእያ ጥራይ እዮም ዚምልከቱ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "እነዚህ የመልክ ምርጫዎች በዚህ ውይይት ላይ ባለዎት አመለካከት ላይ ብቻ ተግባራዊ ይሆናሉ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ظاہری شکل کے یہ انتخاب صرف اس گفتگو کے آپ کے نقطہ نظر پر لاگو ہوتے ہیں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "این انتخاب های ظاهری فقط در مورد دید شما در مورد این مکالمه صدق میکند."
          }
        }
      }
    },
    "chat.appearance_preview": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make this conversation yours"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbeti kendinize göre düzenleyin"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjør denne samtalen din"
