    "chat.block_note": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Blocking prevents conversation access and further contact in either direction. You can manage blocked members in Settings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Engelleme, her iki yönde de sohbete erişimi ve iletişimi önler. Engellediğiniz üyeleri Ayarlar üzerinden yönetebilirsiniz."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokkering forhindrer samtaletilgang og ytterligere kontakt i begge retninger. Du kan administrere blokkerte medlemmer i Innstillinger."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمنع الحظر الوصول إلى المحادثة ومزيد من الاتصال في أي من الاتجاهين. يمكنك إدارة الأعضاء المحظورين في الإعدادات."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مسدود کردن از دسترسی به مکالمه و تماس بیشتر در هر جهت جلوگیری می کند. می توانید اعضای مسدود شده را در تنظیمات مدیریت کنید."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le blocage empêche l’accès à la conversation et tout autre contact dans les deux sens. Vous pouvez gérer les membres bloqués dans Paramètres."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El bloqueo impide el acceso a la conversación y un mayor contacto en cualquier dirección. Puedes administrar miembros bloqueados en Configuración."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Blockieren verhindert den Zugang zu Gesprächen und weiteren Kontakt in beide Richtungen. Sie können blockierte Mitglieder in den Einstellungen verwalten."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокування забороняє доступ до розмови та подальший контакт у будь-якому напрямку. Керувати заблокованими учасниками можна в налаштуваннях."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Блокировка предотвращает доступ к разговору и дальнейший контакт в любом направлении. Вы можете управлять заблокированными участниками в настройках."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blokowanie uniemożliwia dostęp do rozmowy i dalszy kontakt w którąkolwiek stronę. Możesz zarządzać zablokowanymi członkami w Ustawieniach."
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Xannibaadu waxay ka hortagtaa gelitaanka wada hadalka iyo xidhiidh dheeraad ah oo labada dhinac ah. Waxaad maamuli kartaa xubnaha la xannibay ee ku jira Settings."
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "ምዕጋት ዕላል ምብጻሕን ተወሳኺ ርክብን ብኽልቲኡ ኣንፈት ይኽልክል። ኣብ ቅጥዕታት ዝተዓጽዉ ኣባላት ከተመሓድር ትኽእል ኢኻ።"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ማገድ የውይይት መዳረሻን እና ተጨማሪ ግንኙነትን በሁለቱም አቅጣጫዎች ይከለክላል። በቅንብሮች ውስጥ የታገዱ አባላትን ማስተዳደር ትችላለህ።"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مسدود کرنا کسی بھی سمت میں بات چیت تک رسائی اور مزید رابطے کو روکتا ہے۔ آپ سیٹنگز میں بلاک شدہ ممبران کا نظم کر سکتے ہیں۔"
          }
        },
        "fa-AF": {
          "stringUnit": {
