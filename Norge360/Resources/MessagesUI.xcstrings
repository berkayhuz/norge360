        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зробіть цю розмову вашою"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сделайте этот разговор своим"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczyń tę rozmowę swoją"
          }
        },
        "so": {
          "stringUnit": {
            "state": "translated",
            "value": "Wada hadalkan ka dhig mid adiga leh"
          }
        },
        "ti": {
          "stringUnit": {
            "state": "translated",
            "value": "እዚ ዕላል ናትካ ግበሮ"
          }
        },
        "am": {
          "stringUnit": {
            "state": "translated",
            "value": "ይህን ውይይት ያንተ ያድርጉት"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس گفتگو کو اپنا بنائیں"
          }
        },
        "fa-AF": {
          "stringUnit": {
            "state": "translated",
            "value": "این گپ را مال خود بسازید"
          }
        }
      }
    },
