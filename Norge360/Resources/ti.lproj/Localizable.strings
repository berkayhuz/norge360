"legal.terms_intro" = "እዞም ቃላት እዚኦም መሰረታዊ ሕግታት ኣጠቓቕማ መተግበሪ Norge360ን ናይ ምግዓዝ ውጥን ባህርያቱን ዝገልጹ እዮም።";
"legal.privacy_intro" = "እዚ ፖሊሲ እዚ Norge360 ከሰላስሎ ዝኽእል ዓይነታት ሓበሬታን ንዕኡ ንምክልኻል ዝጥቀመሉ መትከላት ብሕታዊነትን ይገልጽ።";
"legal.informational_title" = "ኣገልግሎት ሓበሬታ";
"legal.informational_body" = "Norge360 ናይ ውጥንን ሓበሬታን መሳርሒ እዩ። መንግስታዊ ትካል፣ ጠበቓ ኢሚግሬሽን፣ ኣማኻሪ ግብሪ፣ ወይ ወግዓዊ መመልከቲ ፖርታል ኣይኮነን።";
"legal.account_title" = "ኣካውንትካ";
"legal.account_body" = "ዝርዝር ምእታውካ ውሑስ ናይ ምሕላውን ብሕታዊ ባህርያት ክትጥቀም ከለኻ ቅኑዕ ሓበሬታ ናይ ምሃብን ሓላፍነት ኣለካ።";
"legal.sources_title" = "ወግዓዊ ምንጭታት";
"legal.sources_body" = "ኣገባባዊ ሓበሬታ ክቕየር ይኽእል እዩ። ኩሉ ግዜ ኣገደስቲ ጠለባት ምስቲ ካብቲ መመልከቲ ዝተኣሳሰር ወግዓዊ በዓል መዚ ኣረጋግጽ።";
"legal.acceptable_use_title" = "ቅቡል ኣጠቓቕማ";
"legal.acceptable_use_body" = "ነቲ ኣገልግሎት ብዘይግቡእ ኣይትጠቐመሉ፣ ኣብ ኣሰራርሓኡ ጣልቃ ኣይትእቶ፣ ብዘይፍቓድ ክትረኽቦ ኣይትፈትን፣ ወይ ድማ ነቲ ተግባራዊ ሕጊ ብዝጥሕስ መንገዲ ኣይትጠቐመሉ።";
"legal.changes_title" = "ኣብቲ ኣገልግሎት ዝመጽእ ለውጢ";
"legal.changes_body" = "ባህርያትን እዞም ቃላትን Norge360 እናማዕበለ ምስ ከደ ክመሓየሹ ይኽእሉ እዮም። ንዋታዊ ለውጢ ብመንገዲ እቲ መመልከቲ ክሕበር ኣለዎ።";
"legal.data_title" = "እንእክቦ ሓበሬታ";
"legal.data_body" = "እቲ ኣገልግሎት፡ ዝተሓተቱ ባህርያት ንምሃብ ኣብ ዘድልየሉ እዋን፡ ናይ ኢመይል ኣድራሻኻ፡ ምርጫ ቋንቋኻ፡ መልሲ ምግዓዝካ፡ ምዕባለ ዝርዝር መፈተሺኻን ስናርዮታት ካልኩሌተርካን ከሰላስል ይኽእል።";
"legal.use_title" = "ሓበሬታ ብኸመይ ይጥቀመሉ";
"legal.use_body" = "ሓበሬታ ንሕሳብካ ንምሃብ፣ ውጥን ምግዓዝካ ንምፍጣር፣ ምዕባለ ንምዕቃብ፣ ነቲ ኣገልግሎት ንምውሓስን ንቐንዲ ፍርያት ተኣማንነት ንምምሕያሽን ይጥቀመሉ።";
"legal.sensitive_title" = "ስሱዕ ሓበሬታ";
"legal.sensitive_body" = "ቁጽሪ ፓስፖርት፡ ቁጽሪ ሃገራዊ መንነት፡ መረጋገጺ ባንክኣይዲ፡ መረጋገጺ ባንክ፡ መዛግብቲ ጥዕና፡ ወይ መለለዪ ጉዳይ ኢሚግሬሽን ኣይተቕርቡ።";
"legal.security_title" = "መኽዘንን ድሕንነትን";
"legal.security_body" = "Norge360 ዝተኣከበ ዳታ ንምንካይን ብመገዲ ምቁጽጻር ምብጻሕን ውሑስ ውቅር ኣገልግሎትን ኣቢሉ ሓበሬታ ኣካውንት ንምሕላውን ዝተዳለወ እዩ።";
"legal.rights_title" = "ምርጫታትካ";
"legal.rights_body" = "ምስ ኣካውንትካ ዝተኣሳሰር ናይ ፕሮፋይል ሓበሬታ ክትምርምሮ፡ ከተዐርዮ ወይ ክትድምስሶ ክትክእል ኣለካ፡ እዚ ድማ ብመሰረት ዝምልከቶ ረቛሒታት እዩ።";
"legal.review_notice" = "ረቂቕ ቅዳሕ ፍርያት — ሕጋዊ ገምጋም ምርካብን ቅድሚ ምፍራይ ምፍናው ዝርዝር ናይ ኩባንያ/ርክብ ምውሳኽን።";
"introduction.details_title" = "ዝያዳ ንጹር ስጉምቲ፡ ሓደ ስጉምቲ ኣብ ሓደ እዋን";
"introduction.details_body" = "ንዝያዳ ሓበሬታ ነዚ ፓነል ንላዕሊ ስሓቦ። Norge360 ዝቕጽል ስጉምትታትካ፡ ወግዓዊ ምንጭታትካን መዓልታዊ ውጥንካን ኣብ ሓደ ህዱእ ቦታ የምጽኦ።";
