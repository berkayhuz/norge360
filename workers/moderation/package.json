{
  "name": "norge360-moderation-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "types:check": "wrangler types --check",
    "secret-scan": "python3 ../../scripts/check_worker_secrets.py",
    "test": "python3 ../../scripts/test_worker_security.py && npm run test:runtime",
    "test:runtime": "tsx --test src/index.runtime.test.ts",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "wrangler": "^4.130.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
